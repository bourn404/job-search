# Copy to .env. Loaded automatically by the CLI.

# Your résumé contact details (config/profile.ts reads these so they stay out of git).
PROFILE_EMAIL=you@example.com
PROFILE_PHONE=555-555-5555

# Data store. Default: local SQLite at data/job-search.db, created on first use. Nothing to set up.
# DB_BACKEND=sqlite            # sqlite | directus (auto: directus when DIRECTUS_URL + DIRECTUS_TOKEN are set)
# SQLITE_PATH=data/job-search.db

# Directus backend (optional hosted alternative with an admin UI). Create a static token under
# User menu > (a service user) > Token, or Settings > Access Tokens.
# DIRECTUS_URL=https://directus.example.com
# DIRECTUS_TOKEN=your-static-access-token

# Where `tailor attach --export` copies final PDFs (default ~/resumes).
# RESUMES_DIR=~/resumes
